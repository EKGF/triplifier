# Terms the triplifier emits that are not (yet) in the EKGF Raw Data
# Ontology (ekg-ontologies/ekgf-raw.ttl). Proposed for upstreaming.
@prefix :     <https://ekgf.org/ontology/raw#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:CsvFile a owl:Class ;
    rdfs:subClassOf :File ;
    rdfs:label "CSV file" ;
    skos:definition "A raw-data file source in comma-separated values format (RFC 4180)." .

:TsvFile a owl:Class ;
    rdfs:subClassOf :File ;
    rdfs:label "TSV file" ;
    skos:definition "A raw-data file source in tab-separated values format." .

:viewNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :View ;
    rdfs:range xsd:integer ;
    rdfs:label "view number" ;
    skos:definition "1-based position of the view within its source, e.g. the worksheet index in a workbook." .

:gitRepository a owl:DatatypeProperty ;
    rdfs:domain :File ;
    rdfs:range xsd:string ;
    rdfs:label "git repository" ;
    skos:definition "Fetch URL of the default remote of the git repository the file was read from, verbatim." .

:gitCommit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :File ;
    rdfs:range xsd:string ;
    rdfs:label "git commit" ;
    skos:definition "Object id of the HEAD commit of the repository at capture time." .

:gitPath a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :File ;
    rdfs:range xsd:string ;
    rdfs:label "git path" ;
    skos:definition "Path of the file relative to the repository work tree, '/'-separated." .

:gitBlob a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :File ;
    rdfs:range xsd:string ;
    rdfs:label "git blob" ;
    skos:definition "Git blob object id (SHA-1) of the captured bytes, computed whether or not the file is in a repository." .

:gitModified a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :File ;
    rdfs:range xsd:boolean ;
    rdfs:label "git modified" ;
    skos:definition "True when the captured bytes differ from the file at gitCommit, including when the file is untracked." .

:formula a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Value ;
    rdfs:range xsd:string ;
    rdfs:label "formula" ;
    skos:definition "The spreadsheet formula that computed this value, verbatim in A1 notation without the leading '='. raw:literalValue holds the result the workbook cached, if any." .

:formulaR1C1 a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "formula (R1C1)" ;
    skos:definition "The formula in R1C1 notation relative to its cell. On a raw:Value: that cell's formula. On a raw:Column: the single relative formula shared by every formula cell in the column, i.e. a derivation rule for the column." .
